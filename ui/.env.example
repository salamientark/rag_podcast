# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

OPENAI_API_KEY=****
ANTHROPIC_API_KEY=*****
# Only needed for the providers selected below
# GOOGLE_GENERATIVE_AI_API_KEY=****
# XAI_API_KEY=****
# DEEPSEEK_API_KEY=****

# Model selection as "provider:model" (optional, defaults shown) - see lib/ai/providers.ts
# Providers: openai, anthropic, google, xai, deepseek
# The chat models must support tool calling
# CHAT_MODEL=openai:gpt-5.2
# CHAT_REASONING_MODEL=openai:gpt-5.2
# TITLE_MODEL=anthropic:claude-haiku-4-5
# ARTIFACT_MODEL=anthropic:claude-haiku-4-5

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Postgres database parameters
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

FRONTEND_USER_NAME=frontend_user
FRONTEND_USER_PASSWORD=****
FRONTEND_DB_NAME=frontend_db
FRONTEND_URL="postgresql://${FRONTEND_USER_NAME}:${FRONTEND_USER_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${FRONTEND_DB_NAME}?sslmode=require&channel_binding=require"


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****
AUTH_DISCORD_ID=****
AUTH_DISCORD_SECRET=****

MCP_SERVER_URL=http://localhost:8080/sse
MCP_PRIVATE_KEY=*******

# LANGFUSE
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
