# Feed URL for the podcast
FEED_URL=https://example.com/podcast/feed.xml

# SQLite database URL
DATABASE_URL=sqlite:///example_dir/example_db.db

# Google Gemini API key for transcription
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key for LLM
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=

# Voyage AI API key for embeddings
VOYAGE_API_KEY=your_voyageai_api_key

# Qdrant vector database configuration
# URL for Qdrant server (default: http://localhost:6333) for local dev
QDRANT_URL=http://localhost:6333
# API key for Qdrant Cloud (comment out or delete for local Qdrant)
QDRANT_API_KEY=your_qdrant_api_key_here
# Default collection name for podcast embeddings
QDRANT_COLLECTION_NAME=example_collection


# Cloud storage configuration (DigitalOcean Spaces or S3-compatible)
BUCKET_ENDPOINT=https://your-region.digitaloceanspaces.com
BUCKET_KEY_ID=your_access_key_id
BUCKET_ACCESS_KEY=your_secret_access_key
BUCKET_NAME=your_bucket_name

# POSTGRES SETUP
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

BACKEND_USER_NAME=backend_user
BACKEND_USER_PASSWORD=YOURBACKENDPASSWORD
BACKEND_DB_NAME=your_backend_database_name
BACKEND_URL=postgresql://${BACKEND_USER_NAME}:${BACKEND_USER_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${BACKEND_DB_NAME}

# JWT
JWT_PUBLIC_KEY_PATH=./path_to_your_jwt_public_key.pem

# LANGFUSE
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

COHERE_API_KEY=

# Model selection (optional, defaults shown) - see src/model_config.py
# GEMINI_TRANSCRIPTION_MODEL=gemini-3-flash-preview
# OPENAI_SUMMARY_MODEL=gpt-5.2
# COHERE_RERANK_MODEL=rerank-v3.5
# Changing the embedding model requires re-embedding every episode in Qdrant.
# Must be a model listed in VOYAGE_LIMITS (src/chunker/token_counter.py):
# voyage-3.5, voyage-3.5-lite, voyage-3-large, voyage-3, voyage-code-3
# VOYAGE_EMBEDDING_MODEL=voyage-3.5
